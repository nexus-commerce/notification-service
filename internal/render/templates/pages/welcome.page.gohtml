{{template "base" .}}

{{define "title"}}Welcome to MyEcom{{end}}

{{define "header"}}Welcome to MyEcom!{{end}}

{{define "content"}}
    <div style="text-align: center;">
        <p>{{.Greeting}}</p>
        <p>Your email address is confirmed and your MyEcom account is ready.</p>
        <p>You can now browse our collection and start shopping.</p>
        <a href="{{.LoginURL}}" class="button">Log in</a>
        <p>If the button above doesn't work, copy and paste this link into your browser:</p>
        <p><a href="{{.LoginURL}}">{{.LoginURL}}</a></p>
    </div>
{{end}}

{{define "footer-text"}}Thank you for joining us!{{end}}
