{{template "base" .}}

{{define "title"}}You already have a MyEcom account{{end}}

{{define "header"}}You already have an account{{end}}

{{define "content"}}
    <div style="text-align: center;">
        <p>{{if .FirstName}}Hi {{.FirstName}},{{else}}Hello,{{end}}</p>
        <p>Someone tried to register a MyEcom account with this email address, but an account already exists.</p>
        <p>If this was you, simply log in. If you forgot your password, you can reset it on the login page.</p>
        <a href="{{.LoginURL}}" class="button">Log in</a>
        <p>If the button above doesn't work, copy and paste this link into your browser:</p>
        <p><a href="{{.LoginURL}}">{{.LoginURL}}</a></p>
        <p>If it was not you, no action is needed.</p>
    </div>
{{end}}

{{define "footer-text"}}Thank you for being with us!{{end}}
